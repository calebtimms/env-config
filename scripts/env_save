#!/usr/bin/env bash

set -uo pipefail

REPO="${ENV_CONFIG_REPO:-$HOME/env-config}"

PACKAGES="$REPO/packages"
STATE="$REPO/state"
SYSTEM="$REPO/system"

mkdir -p \
    "$PACKAGES" \
    "$STATE" \
    "$SYSTEM/etc" \
    "$SYSTEM/efi"


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

run_if_exists()
{
    local command_name="$1"
    local output="$2"
    shift 2

    if command -v "$command_name" >/dev/null 2>&1; then
        "$@" > "$output" 2>&1 || true
    else
        rm -f "$output"
    fi
}


capture_root_file()
{
    local src="$1"
    local dest="$SYSTEM/${src#/}"

    if ! sudo test -f "$src"; then
        return
    fi

    mkdir -p "$(dirname "$dest")"

    # sudo reads the protected file, but the user's shell creates the
    # destination so the resulting Git file remains owned by the user.
    sudo cat "$src" > "$dest"
}


capture_root_tree()
{
    local src="$1"
    local dest="$SYSTEM/${src#/}"
    local parent
    local base
    local tmp

    if ! sudo test -d "$src"; then
        rm -rf "$dest"
        return
    fi

    parent="$(dirname "$src")"
    base="$(basename "$src")"

    tmp="$(mktemp -d)" || {
        echo "WARNING: Failed to create temporary directory for $src" >&2
        return 1
    }

    # Use explicit GNU tar paths/options and ignore any inherited TAR_OPTIONS.
    # Extract as the current user so files in the Git repo remain user-owned.
    if sudo env -u TAR_OPTIONS /usr/bin/tar \
            --create \
            --file=- \
            --directory="$parent" \
            -- "$base" \
        | env -u TAR_OPTIONS /usr/bin/tar \
            --extract \
            --file=- \
            --directory="$tmp" \
            --no-same-owner
    then
        mkdir -p "$(dirname "$dest")"

        # Only destroy the previous capture AFTER the new one succeeded.
        rm -rf "$dest"
        mv "$tmp/$base" "$dest"
    else
        echo "WARNING: Failed to capture $src" >&2
    fi

    rm -rf "$tmp"
}


capture_user_tree()
{
    local src="$1"
    local rel="${src#$HOME/}"
    local dest="$REPO/user/$rel"

    if [[ ! -d "$src" ]]; then
        rm -rf "$dest"
        return
    fi

    rm -rf "$dest"
    mkdir -p "$(dirname "$dest")"

    cp -a "$src" "$dest"
}


capture_user_file()
{
    local src="$1"
    local rel="${src#$HOME/}"
    local dest="$REPO/user/$rel"

    if [[ ! -f "$src" ]]; then
        rm -f "$dest"
        return
    fi

    mkdir -p "$(dirname "$dest")"
    cp -a "$src" "$dest"
}


capture_user_state_file()
{
    local src="$1"
    local rel="${src#$HOME/}"
    local dest="$STATE/user/$rel"

    if [[ ! -f "$src" ]]; then
        rm -f "$dest"
        return
    fi

    mkdir -p "$(dirname "$dest")"
    cp -a "$src" "$dest"
}


capture_user_state_tree()
{
    local src="$1"
    local rel="${src#$HOME/}"
    local dest="$STATE/user/$rel"

    if [[ ! -d "$src" ]]; then
        rm -rf "$dest"
        return
    fi

    rm -rf "$dest"
    mkdir -p "$(dirname "$dest")"
    cp -a "$src" "$dest"
}


capture_git_repo_inventory()
{
    local output="$1"
    shift

    : > "$output"

    local root
    local git_dir
    local repo
    local rel
    local remote
    local branch
    local commit
    local dirty

    for root in "$@"; do
        [[ -d "$root" ]] || continue

        while IFS= read -r -d '' git_dir; do
            repo="${git_dir%/.git}"
            rel="${repo#$HOME/}"

            remote="$(
                git -C "$repo" remote get-url origin 2>/dev/null \
                    || printf '%s' '-'
            )"

            branch="$(
                git -C "$repo" branch --show-current 2>/dev/null
            )"

            [[ -n "$branch" ]] || branch="DETACHED"

            commit="$(
                git -C "$repo" rev-parse HEAD 2>/dev/null \
                    || printf '%s' '-'
            )"

            if [[ -n "$(git -C "$repo" status --porcelain 2>/dev/null)" ]]; then
                dirty="DIRTY"
            else
                dirty="clean"
            fi

            printf '%s\t%s\t%s\t%s\t%s\n' \
                "$rel" \
                "$remote" \
                "$branch" \
                "$commit" \
                "$dirty" \
                >> "$output"

        done < <(
            find "$root" \
                -type d \
                -name .git \
                -prune \
                -print0 2>/dev/null
        )
    done
    LC_ALL=C sort -o "$output" "$output"
}


# ---------------------------------------------------------------------------
# Pacman / package state
# ---------------------------------------------------------------------------

pacman -Qqen | LC_ALL=C sort > "$PACKAGES/official.txt"
pacman -Qqem | LC_ALL=C sort > "$PACKAGES/foreign.txt"

# ---------------------------------------------------------------------------
# Flatpak
# ---------------------------------------------------------------------------

if command -v flatpak >/dev/null 2>&1; then

    # Installed applications:
    #
    #   scope<TAB>application<TAB>origin
    #
    # Keep user/system scope because Flatpak treats these as distinct
    # installations.

    {
        flatpak list \
            --system \
            --app \
            --columns=application,origin \
            2>/dev/null \
            | awk -F '\t' '
                NF >= 2 {
                    printf "system\t%s\t%s\n", $1, $2
                }
            ' \
            || true

        flatpak list \
            --user \
            --app \
            --columns=application,origin \
            2>/dev/null \
            | awk -F '\t' '
                NF >= 2 {
                    printf "user\t%s\t%s\n", $1, $2
                }
            ' \
            || true

    } | LC_ALL=C sort -u \
        > "$PACKAGES/flatpak.txt"


    # Configured repositories:
    #
    #   scope<TAB>name<TAB>url

    {
        flatpak remotes \
            --system \
            --columns=name,url \
            2>/dev/null \
            | awk -F '\t' '
                NF >= 2 {
                    printf "system\t%s\t%s\n", $1, $2
                }
            ' \
            || true

        flatpak remotes \
            --user \
            --columns=name,url \
            2>/dev/null \
            | awk -F '\t' '
                NF >= 2 {
                    printf "user\t%s\t%s\n", $1, $2
                }
            ' \
            || true

    } | LC_ALL=C sort -u \
        > "$PACKAGES/flatpak-remotes.txt"

else
    rm -f \
        "$PACKAGES/flatpak.txt" \
        "$PACKAGES/flatpak-remotes.txt"
fi


# VS Code / Code extensions
if command -v code >/dev/null 2>&1; then
    code --list-extensions | LC_ALL=C sort > "$PACKAGES/code-extensions.txt"
fi


# ---------------------------------------------------------------------------
# systemd state
# ---------------------------------------------------------------------------

systemctl list-unit-files \
    --state=enabled \
    --no-legend \
    --no-pager \
    | awk '{print $1}' \
    | LC_ALL=C sort \
    > "$STATE/systemd-system-enabled.txt"


# ---------------------------------------------------------------------------
# User systemd enablement
#
# systemctl --user reports the effective user-unit view, which includes
# units enabled globally for all users. Save global enablement separately,
# then record only the additional per-user enablement in user-enabled.txt.
# ---------------------------------------------------------------------------

if systemctl --global list-unit-files \
    --state=enabled \
    --no-legend \
    --no-pager \
    2>/dev/null \
    | awk '{print $1}' \
    | LC_ALL=C sort -u \
    > "$STATE/systemd-global-user-enabled.txt"
then
    :
else
    rm -f "$STATE/systemd-global-user-enabled.txt"
fi


if [[ -f "$STATE/systemd-global-user-enabled.txt" ]]; then

    comm -23 \
        <(
            systemctl --user list-unit-files \
                --state=enabled \
                --no-legend \
                --no-pager \
                2>/dev/null \
                | awk '{print $1}' \
                | LC_ALL=C sort -u
        ) \
        "$STATE/systemd-global-user-enabled.txt" \
        > "$STATE/systemd-user-enabled.txt" \
        || true

else
    rm -f "$STATE/systemd-user-enabled.txt"
fi


systemctl get-default > "$STATE/systemd-default-target.txt" 2>&1 || true


# ---------------------------------------------------------------------------
# Basic system information
# ---------------------------------------------------------------------------

uname -a > "$STATE/uname.txt"

cat /proc/cmdline > "$STATE/kernel-cmdline.txt"

hostnamectl | grep -vE '^[[:space:]]*(Machine ID|Boot ID|Firmware Age):' > "$STATE/hostnamectl.txt" 2>&1 || true

localectl status > "$STATE/localectl.txt" 2>&1 || true

timedatectl show \
    -p Timezone \
    -p LocalRTC \
    -p NTP \
    > "$STATE/timedatectl.txt" 2>&1 || true

# ---------------------------------------------------------------------------
# Hardware / filesystem layout
# ---------------------------------------------------------------------------

lsblk \
    --raw \
    --noheadings \
    --output NAME,SIZE,TYPE,FSTYPE,FSVER,LABEL,UUID,PARTUUID \
    | LC_ALL=C sort \
    > "$STATE/lsblk.txt"

# Basic PCI hardware inventory; does not require kernel module metadata.
lspci -nn > "$STATE/lspci.txt" 2>&1 || true

# Driver/module association. May report unavailable module metadata
# immediately after a kernel package upgrade but before reboot.
lspci -nnk > "$STATE/lspci-kernel-drivers.txt" 2>&1 || true

lsusb \
    | sed -E 's/^Bus [0-9]+ Device [0-9]+: //' \
    | LC_ALL=C sort \
    > "$STATE/lsusb.txt"


# ---------------------------------------------------------------------------
# Boot environment
# ---------------------------------------------------------------------------

bootctl status > "$STATE/bootctl.txt" 2>&1 || true

SBCTL_UNICODE=0 sbctl --json verify 2>/dev/null \
    | jq -S . \
    > "$STATE/sbctl-verify.json" \
    || true

# ---------------------------------------------------------------------------
# Root-access state
# ---------------------------------------------------------------------------

HAVE_SUDO=0

if [[ "${1:-}" != "--no-root" ]]; then
    if sudo -v; then
        HAVE_SUDO=1
    fi
fi


if (( HAVE_SUDO )); then

    sudo blkid 2>/dev/null \
        | LC_ALL=C sort \
        > "$STATE/blkid.txt" \
        || true

    sudo efibootmgr -v 2>/dev/null \
        | grep -vE '^(BootCurrent|BootNext):' \
        > "$STATE/efibootmgr.txt" \
        || true

    sudo btrfs subvolume list / \
        | sed -n 's/.* path //p' \
        | grep -vE '(^|/)\.snapshots(/|$)' \
        | LC_ALL=C sort \
        > "$STATE/btrfs-subvolumes.txt"

    if command -v pvs >/dev/null 2>&1; then
        sudo pvs > "$STATE/lvm-pvs.txt" 2>&1 || true

        sudo vgs > "$STATE/lvm-vgs.txt" 2>&1 || true

        sudo lvs -a -o +devices > "$STATE/lvm-lvs.txt" 2>&1 || true
    fi


    # -----------------------------------------------------------------------
    # Carefully selected system configuration
    # -----------------------------------------------------------------------

    capture_root_file /etc/fstab
    capture_root_file /etc/crypttab
    
    capture_root_file /etc/mkinitcpio.conf
    
    capture_root_file /etc/pacman.conf
    capture_root_file /etc/makepkg.conf
    
    capture_root_file /etc/hostname
    capture_root_file /etc/hosts
    
    capture_root_file /etc/locale.conf
    capture_root_file /etc/locale.gen
    capture_root_file /etc/vconsole.conf
    
    capture_root_file /etc/environment
    
    capture_root_file /etc/snapper/configs/root
    
    capture_root_file /efi/loader/loader.conf

    capture_root_file /etc/systemd/logind.conf
    capture_root_file /etc/systemd/sleep.conf
    capture_root_file /etc/systemd/resolved.conf
    capture_root_file /etc/systemd/timesyncd.conf
    capture_root_file /etc/systemd/journald.conf
    
    capture_root_file /etc/ssh/sshd_config

    # -----------------------------------------------------------------------
    # Local system configuration trees
    # -----------------------------------------------------------------------
    
    capture_root_tree /etc/pacman.d/hooks
    
    capture_root_tree /etc/modprobe.d
    capture_root_tree /etc/modules-load.d
    
    capture_root_tree /etc/udev/rules.d
    
    capture_root_tree /etc/sysctl.d
    capture_root_tree /etc/tmpfiles.d
    
    capture_root_tree /etc/systemd/system
    capture_root_tree /etc/systemd/user
    
    capture_root_tree /etc/mkinitcpio.d
    capture_root_tree /etc/kernel
    
    capture_root_tree /etc/sddm.conf.d
    
    capture_root_tree /etc/X11/xorg.conf.d
    
    capture_root_tree /etc/environment.d
    
    capture_root_tree /etc/NetworkManager/conf.d
    capture_root_tree /etc/NetworkManager/dispatcher.d

    capture_root_tree /etc/systemd/logind.conf.d
    capture_root_tree /etc/systemd/sleep.conf.d
    capture_root_tree /etc/systemd/resolved.conf.d
    capture_root_tree /etc/systemd/timesyncd.conf.d
    capture_root_tree /etc/systemd/journald.conf.d
    
    capture_root_tree /etc/security/limits.d
    capture_root_tree /etc/ssh/sshd_config.d

    capture_root_tree /usr/local/bin

    LOADER_ENTRIES_DEST="$SYSTEM/efi/loader/entries"
    
    rm -rf "$LOADER_ENTRIES_DEST"
    
    if sudo test -d /efi/loader/entries; then
        mkdir -p "$LOADER_ENTRIES_DEST"
    
        while IFS= read -r entry; do
            dest="$SYSTEM/${entry#/}"
            sudo cat "$entry" > "$dest"
        done < <(
            sudo find /efi/loader/entries \
                -maxdepth 1 \
                -type f \
                -name '*.conf' \
                -print \
                | LC_ALL=C sort
        )
    fi
fi


# -----------------------------------------------------------------------
# User configuration trees/files
# -----------------------------------------------------------------------
capture_user_tree "$HOME/.config/systemd/user"
capture_user_tree "$HOME/.config/environment.d"
capture_user_tree "$HOME/.config/autostart"

capture_user_file "$HOME/.local/share/applications/sierra.desktop"
capture_user_file "$HOME/.local/share/icons/sierra.png"
capture_user_file "$HOME/.local/share/applications/trading-dashboard.desktop"

capture_user_file "$HOME/.ssh/config"

capture_user_file "$HOME/.config/mimeapps.list"

capture_user_file "$HOME/.config/user-dirs.dirs"
capture_user_file "$HOME/.config/user-dirs.locale"

# ---------------------------------------------------------------------------
# KDE / Plasma user configuration
# ---------------------------------------------------------------------------

capture_user_file "$HOME/.config/kdeglobals"

capture_user_file "$HOME/.config/kglobalshortcutsrc"

capture_user_file "$HOME/.config/kcminputrc"
capture_user_file "$HOME/.config/kscreenlockerrc"

capture_user_file "$HOME/.config/kwinrc"
capture_user_file "$HOME/.config/kwinrulesrc"

capture_user_file "$HOME/.config/plasma-localerc"

capture_user_file "$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc"

capture_user_file "$HOME/.config/plasmanotifyrc"
capture_user_file "$HOME/.config/plasmarc"
capture_user_file "$HOME/.config/plasmashellrc"

capture_user_file "$HOME/.config/powerdevilrc"
capture_user_file "$HOME/.config/powermanagementprofilesrc"

capture_user_file "$HOME/.config/plasmaparc"
capture_user_file "$HOME/.config/kded5rc" 

KWIN_OUTPUT_SRC="$HOME/.config/kwinoutputconfig.json"
KWIN_OUTPUT_DEST="$STATE/user/.config/kwinoutputconfig.json"

if [[ -f "$KWIN_OUTPUT_SRC" ]]; then
    mkdir -p "$(dirname "$KWIN_OUTPUT_DEST")"

    if command -v jq >/dev/null 2>&1; then
        jq --sort-keys . \
            "$KWIN_OUTPUT_SRC" \
            > "$KWIN_OUTPUT_DEST"
    else
        cp "$KWIN_OUTPUT_SRC" "$KWIN_OUTPUT_DEST"
    fi
else
    rm -f "$KWIN_OUTPUT_DEST"
fi

KWIN_POS_SRC="$HOME/.config/kde.org/kwin.conf"
KWIN_POS_DEST="$STATE/user/.config/kde.org/kwin-overrides.conf"

if [[ -f "$KWIN_POS_SRC" ]]; then
    mkdir -p "$(dirname "$KWIN_POS_DEST")"

    grep -E \
        '^(rememberwindowpositions_configOverrides|rememberwindowpositions_currentDefaultOverrideCount)=' \
        "$KWIN_POS_SRC" \
        > "$KWIN_POS_DEST" \
        || true
else
    rm -f "$KWIN_POS_DEST"
fi

rm -f "$STATE/user/.config/kde.org/kwin.conf"

capture_user_state_tree "$HOME/.config/kdedefaults"

capture_user_file "$HOME/.config/spectaclerc"

# ---------------------------------------------------------------------------
# Locally installed KDE / KWin extensions
# ---------------------------------------------------------------------------

capture_user_tree "$HOME/.local/share/kwin/scripts"
capture_user_tree "$HOME/.local/share/kwin/effects"
capture_user_tree "$HOME/.local/share/plasma/plasmoids"

# ---------------------------------------------------------------------------
# Code OSS
# ---------------------------------------------------------------------------

capture_user_file "$HOME/.config/Code - OSS/User/settings.json"
capture_user_file "$HOME/.config/Code - OSS/User/keybindings.json"

capture_user_tree "$HOME/.config/Code - OSS/User/snippets"

# ---------------------------------------------------------------------------
# VIM Plugins
# ---------------------------------------------------------------------------

capture_git_repo_inventory \
    "$STATE/vim-plugin-git.txt" \
    "$HOME/.vim/pack"

# ---------------------------------------------------------------------------
# GTK Config
# ---------------------------------------------------------------------------

capture_user_file "$HOME/.config/gtk-3.0/settings.ini"
capture_user_file "$HOME/.config/gtk-3.0/gtk.css"

capture_user_file "$HOME/.config/gtk-4.0/settings.ini"
capture_user_file "$HOME/.config/gtk-4.0/gtk.css"

# GTK/XSettings integration
capture_user_tree "$HOME/.config/xsettingsd"

# ---------------------------------------------------------------------------
# Optional user-space development tools
# ---------------------------------------------------------------------------

if command -v cargo >/dev/null 2>&1; then
    cargo install --list \
        > "$STATE/cargo-installed.txt" 2>&1 || true
else
    rm -f "$STATE/cargo-installed.txt"
fi

if command -v rustup >/dev/null 2>&1; then
    rustup toolchain list \
        | sed -E 's/[[:space:]]+\([^)]*\)$//' \
        | LC_ALL=C sort \
        > "$STATE/rust-toolchains.txt"
else
    rm -f "$STATE/rust-toolchains.txt"
fi

if command -v uv >/dev/null 2>&1; then
    uv tool list > "$STATE/uv-tools.txt" 2>&1 || true
fi

if command -v pipx >/dev/null 2>&1; then
    pipx list --short > "$STATE/pipx.txt" 2>&1 || true
fi

if command -v npm >/dev/null 2>&1; then
    npm --global ls --depth=0 > "$STATE/npm-global.txt" 2>&1 || true
fi


# ---------------------------------------------------------------------------
# Finish
# ---------------------------------------------------------------------------

echo
echo "--- Environment saved ---"
echo

git -C "$REPO" status --short
