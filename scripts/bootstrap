#!/usr/bin/env bash

set -euo pipefail


# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

REPO="${ENV_CONFIG_REPO:-$HOME/env-config}"

DOTFILES="$REPO/dotfiles"
PACKAGES="$REPO/packages"
USER_CONFIG="$REPO/user"
SYSTEM_CONFIG="$REPO/system"
STATE="$REPO/state"
PATCHES="$REPO/patches"

STAMP="$(date +%Y%m%d-%H%M%S)"

BACKUP_ROOT="$HOME/.local/state/env-config-bootstrap/$STAMP"


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

info()
{
    printf '\n--- %s ---\n\n' "$*"
}


warn()
{
    printf 'WARNING: %s\n' "$*" >&2
}


die()
{
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}


confirm()
{
    local prompt="$1"
    local reply

    printf '%s [y/N] ' "$prompt"
    read -r reply

    [[ "$reply" =~ ^[Yy]$ ]]
}


require-arch()
{
    [[ -f /etc/arch-release ]] \
        || die "This bootstrap is intended for Arch Linux."
}


require-not-root()
{
    (( EUID != 0 )) \
        || die "Run bootstrap as your normal user, not root."
}


require-repo()
{
    [[ -d "$REPO" ]] \
        || die "Environment repository not found: $REPO"

    [[ -d "$DOTFILES" ]] \
        || die "Missing dotfiles directory: $DOTFILES"

    [[ -d "$PACKAGES" ]] \
        || die "Missing packages directory: $PACKAGES"

    [[ -d "$STATE" ]] \
        || die "Missing state directory: $STATE"
}


backup-user-path()
{
    local target="$1"
    local rel
    local backup

    [[ -e "$target" || -L "$target" ]] || return 0

    rel="${target#$HOME/}"
    backup="$BACKUP_ROOT/user/$rel"

    mkdir -p "$(dirname "$backup")"

    cp -a "$target" "$backup"
}


same-entry()
{
    local src="$1"
    local dest="$2"

    # If either side is a symlink, both must be symlinks.
    if [[ -L "$src" || -L "$dest" ]]; then
        [[ -L "$src" && -L "$dest" ]] || return 1

        [[ "$(readlink -- "$src")" == "$(readlink -- "$dest")" ]]
        return
    fi

    if [[ -f "$src" && -f "$dest" ]]; then
        cmp -s "$src" "$dest"
        return
    fi

    return 1
}


system-safe-entry-differs()
{
    local src="$1"
    local target="$2"

    if [[ -L "$src" ]]; then

        sudo test -L "$target" || return 0

        [[ "$(readlink -- "$src")" != "$(sudo readlink -- "$target")" ]]
        return
    fi

    # Saved regular file must correspond to a real regular file,
    # not merely a symlink resolving to one.
    if sudo test -L "$target" || ! sudo test -f "$target"; then
        return 0
    fi

    ! sudo cmp -s "$src" "$target"
}


backup-system-path()
{
    local target="$1"
    local rel="${target#/}"
    local backup="$BACKUP_ROOT/system/$rel"
    local meta="$backup.env-config-meta"

    if ! sudo test -e "$target" && ! sudo test -L "$target"; then
        return 0
    fi

    mkdir -p "$(dirname "$backup")"

    # Keep the backup area private.
    mkdir -p "$BACKUP_ROOT/system"
    chmod 700 "$BACKUP_ROOT" "$BACKUP_ROOT/system"

    if sudo test -L "$target"; then

        printf 'type=symlink\n' > "$meta"

        printf 'target=%s\n' \
            "$(sudo readlink -- "$target")" \
            >> "$meta"

    elif sudo test -f "$target"; then

        # User-owned backup copy of the file contents.
        sudo cat "$target" > "$backup"

        chmod 600 "$backup"

        {
            printf 'type=file\n'

            sudo stat \
                --format='mode=%a
uid=%u
gid=%g' \
                "$target"

        } > "$meta"

    else
        warn "Refusing to back up unsupported system path type: $target"
        return 1
    fi

    chmod 600 "$meta"
}


restore-system-safe-entry()
{
    local src="$1"
    local rel="${src#$SYSTEM_CONFIG/}"
    local target="/$rel"

    local mode
    local link_target

    # Nothing to do.
    if ! system-safe-entry-differs "$src" "$target"; then
        return
    fi

    # Never replace directories with files/symlinks.
    if sudo test -d "$target" && ! sudo test -L "$target"; then
        die "Refusing to replace directory with file: $target"
    fi

    backup-system-path "$target" \
        || die "Could not back up $target"

    sudo install \
        -d \
        -o root \
        -g root \
        -m 755 \
        "$(dirname "$target")"

    # Remove an existing file/symlink only after backup succeeded.
    if sudo test -e "$target" || sudo test -L "$target"; then
        sudo rm -f -- "$target"
    fi


    if [[ -L "$src" ]]; then

        link_target="$(readlink -- "$src")"

        sudo ln \
            -s \
            -- "$link_target" "$target"

        return
    fi


    # Git reliably preserves the executable bit, but not arbitrary Unix
    # permission modes. Use sane defaults based on executable status.
    if [[ -x "$src" ]]; then
        mode=755
    else
        mode=644
    fi

    sudo install \
        -o root \
        -g root \
        -m "$mode" \
        -- "$src" "$target"
}


preview-system-safe-changes()
{
    local src
    local rel
    local target

    local -a candidates=()

    SYSTEM_SAFE_CHANGES=0

    mapfile -d '' -t candidates < <(
        system-safe-candidates
    )

    for src in "${candidates[@]}"; do

        rel="${src#$SYSTEM_CONFIG/}"
        target="/$rel"

        if ! sudo test -e "$target" \
            && ! sudo test -L "$target"
        then
            printf 'ADD       /%s\n' "$rel"
            SYSTEM_SAFE_CHANGES=$((SYSTEM_SAFE_CHANGES + 1))
            continue
        fi

        if system-safe-entry-differs "$src" "$target"; then
            printf 'DIFFER    /%s\n' "$rel"
            SYSTEM_SAFE_CHANGES=$((SYSTEM_SAFE_CHANGES + 1))
        fi
    done
}


restore-system-safe()
{
    local src
    local -a candidates=()

    info "Safe system configuration restore"

    sudo -v \
        || die "sudo access is required to restore system configuration."

    echo "The following saved system configuration differs:"
    echo

    preview-system-safe-changes

    if (( SYSTEM_SAFE_CHANGES == 0 )); then
        echo "No system-safe configuration changes are required."
        return
    fi

    echo
    echo "$SYSTEM_SAFE_CHANGES system-safe entries would be restored."
    echo
    echo "Existing files will first be backed up under:"
    echo
    echo "  $BACKUP_ROOT/system"
    echo

    confirm "Restore these system configuration files?" \
        || return

    mapfile -d '' -t candidates < <(
        system-safe-candidates
    )

    echo

    for src in "${candidates[@]}"; do

        if system-safe-entry-differs \
            "$src" \
            "/${src#$SYSTEM_CONFIG/}"
        then
            printf 'Restoring /%s\n' \
                "${src#$SYSTEM_CONFIG/}"

            restore-system-safe-entry "$src"
        fi

    done


    # Custom systemd unit/drop-in files may have changed.
    sudo systemctl daemon-reload


    echo
    echo "Verifying restored system-safe configuration:"
    echo

    preview-system-safe-changes

    if (( SYSTEM_SAFE_CHANGES == 0 )); then
        echo
        echo "All system-safe entries now match the saved environment."
    else
        echo
        warn "$SYSTEM_SAFE_CHANGES entries still differ after restoration."
    fi

    echo
    echo "Some restored settings may require a service restart or reboot."
}


restore-services()
{
    local saved_system="$STATE/systemd-system-enabled.txt"
    local saved_global_user="$STATE/systemd-global-user-enabled.txt"
    local saved_user="$STATE/systemd-user-enabled.txt"
    local saved_target_file="$STATE/systemd-default-target.txt"

    local tmp_system
    local tmp_global_user
    local tmp_user

    local missing_system
    local missing_global_user
    local missing_user

    local verify_system
    local verify_global_user
    local verify_user

    local unit
    local current_target=""
    local saved_target=""
    local verified_target=""

    local -a system_enable=()
    local -a global_user_enable=()
    local -a user_enable=()

    local -a system_missing=()
    local -a global_user_missing=()
    local -a user_missing=()

    local changes=0
    local restore_target=0


    [[ -f "$saved_system" ]] \
        || die "Missing saved systemd system-unit state: $saved_system"


    tmp_system="$(mktemp)"
    tmp_global_user="$(mktemp)"
    tmp_user="$(mktemp)"

    missing_system="$(mktemp)"
    missing_global_user="$(mktemp)"
    missing_user="$(mktemp)"


    info "Systemd service restoration"


    # -----------------------------------------------------------------------
    # System services
    # -----------------------------------------------------------------------

    get-enabled-system-units "$tmp_system"

    comm -23 \
        "$saved_system" \
        "$tmp_system" \
        > "$missing_system"

    while IFS= read -r unit; do
        [[ -n "$unit" ]] || continue

        if system-unit-exists "$unit"; then
            system_enable+=("$unit")
        else
            system_missing+=("$unit")
        fi

    done < "$missing_system"


    # -----------------------------------------------------------------------
    # Global user services
    # -----------------------------------------------------------------------

    if [[ -f "$saved_global_user" ]]; then

        if get-enabled-global-user-units "$tmp_global_user"; then

            comm -23 \
                "$saved_global_user" \
                "$tmp_global_user" \
                > "$missing_global_user"

            while IFS= read -r unit; do
                [[ -n "$unit" ]] || continue

                if global-user-unit-exists "$unit"; then
                    global_user_enable+=("$unit")
                else
                    global_user_missing+=("$unit")
                fi

            done < "$missing_global_user"

        else
            warn "Could not query global user systemd units."
        fi
    fi


    # -----------------------------------------------------------------------
    # Per-user services
    # -----------------------------------------------------------------------

    if [[ -f "$saved_user" ]]; then

        if get-enabled-user-units "$tmp_user"; then

            comm -23 \
                "$saved_user" \
                "$tmp_user" \
                > "$missing_user"

            while IFS= read -r unit; do
                [[ -n "$unit" ]] || continue

                if user-unit-exists "$unit"; then
                    user_enable+=("$unit")
                else
                    user_missing+=("$unit")
                fi

            done < "$missing_user"

        else
            warn "Could not query the user systemd manager; user units will be skipped."
        fi
    fi


    # -----------------------------------------------------------------------
    # Default target
    # -----------------------------------------------------------------------

    if [[ -f "$saved_target_file" ]]; then

        saved_target="$(<"$saved_target_file")"
        current_target="$(systemctl get-default 2>/dev/null || true)"

        if [[ -n "$saved_target" \
            && -n "$current_target" \
            && "$saved_target" != "$current_target" ]]
        then
            restore_target=1
        fi
    fi


    # -----------------------------------------------------------------------
    # Preview
    # -----------------------------------------------------------------------

    echo "Changes required:"
    echo

    for unit in "${system_enable[@]}"; do
        printf 'ENABLE    system       %s\n' "$unit"
        changes=$((changes + 1))
    done

    for unit in "${global_user_enable[@]}"; do
        printf 'ENABLE    global-user  %s\n' "$unit"
        changes=$((changes + 1))
    done

    for unit in "${user_enable[@]}"; do
        printf 'ENABLE    user         %s\n' "$unit"
        changes=$((changes + 1))
    done


    if (( restore_target )); then
        printf 'TARGET    system       %s -> %s\n' \
            "$current_target" \
            "$saved_target"

        changes=$((changes + 1))
    fi


    for unit in "${system_missing[@]}"; do
        printf 'SKIP      system       %s  (unit not installed)\n' "$unit"
    done

    for unit in "${global_user_missing[@]}"; do
        printf 'SKIP      global-user  %s  (unit not installed)\n' "$unit"
    done

    for unit in "${user_missing[@]}"; do
        printf 'SKIP      user         %s  (unit not installed)\n' "$unit"
    done


    if (( changes == 0 )); then
        echo
        echo "No systemd enablement changes are required."

        rm -f \
            "$tmp_system" \
            "$tmp_global_user" \
            "$tmp_user" \
            "$missing_system" \
            "$missing_global_user" \
            "$missing_user"

        return
    fi


    # -----------------------------------------------------------------------
    # Confirmation
    # -----------------------------------------------------------------------

    echo
    echo "$changes systemd changes would be made."
    echo
    echo "Units will be enabled but NOT started or restarted."
    echo

    if ! confirm "Restore saved systemd enablement?"; then

        rm -f \
            "$tmp_system" \
            "$tmp_global_user" \
            "$tmp_user" \
            "$missing_system" \
            "$missing_global_user" \
            "$missing_user"

        return
    fi


    # -----------------------------------------------------------------------
    # Rollback log
    # -----------------------------------------------------------------------

    mkdir -p "$BACKUP_ROOT/services"

    chmod 700 \
        "$BACKUP_ROOT" \
        "$BACKUP_ROOT/services"

    : > "$BACKUP_ROOT/services/system-enabled-by-bootstrap.txt"
    : > "$BACKUP_ROOT/services/global-user-enabled-by-bootstrap.txt"
    : > "$BACKUP_ROOT/services/user-enabled-by-bootstrap.txt"

    chmod 600 \
        "$BACKUP_ROOT/services/system-enabled-by-bootstrap.txt" \
        "$BACKUP_ROOT/services/global-user-enabled-by-bootstrap.txt" \
        "$BACKUP_ROOT/services/user-enabled-by-bootstrap.txt"


    # -----------------------------------------------------------------------
    # Apply
    # -----------------------------------------------------------------------

    for unit in "${system_enable[@]}"; do

        echo "Enabling system unit: $unit"

        if sudo systemctl enable "$unit"; then
            printf '%s\n' "$unit" \
                >> "$BACKUP_ROOT/services/system-enabled-by-bootstrap.txt"
        else
            warn "Failed to enable system unit: $unit"
        fi
    done


    for unit in "${global_user_enable[@]}"; do

        echo "Enabling global user unit: $unit"

        if sudo systemctl --global enable "$unit"; then
            printf '%s\n' "$unit" \
                >> "$BACKUP_ROOT/services/global-user-enabled-by-bootstrap.txt"
        else
            warn "Failed to enable global user unit: $unit"
        fi
    done


    for unit in "${user_enable[@]}"; do

        echo "Enabling user unit: $unit"

        if systemctl --user enable "$unit"; then
            printf '%s\n' "$unit" \
                >> "$BACKUP_ROOT/services/user-enabled-by-bootstrap.txt"
        else
            warn "Failed to enable user unit: $unit"
        fi
    done


    if (( restore_target )); then
        echo "Setting default target: $saved_target"

        sudo systemctl set-default "$saved_target"
    fi


    # -----------------------------------------------------------------------
    # Verification
    # -----------------------------------------------------------------------

    echo
    echo "Verifying systemd enablement:"
    echo


    verify_system="$(mktemp)"
    verify_global_user="$(mktemp)"
    verify_user="$(mktemp)"


    # System units

    get-enabled-system-units "$verify_system"

    echo "System units requested by bootstrap but still not enabled:"
    echo

    for unit in "${system_enable[@]}"; do
        if ! grep -Fxq "$unit" "$verify_system"; then
            printf '%s\n' "$unit"
        fi
    done


    # Global user units

    if get-enabled-global-user-units "$verify_global_user"; then

        echo
        echo "Global user units requested by bootstrap but still not enabled:"
        echo

        for unit in "${global_user_enable[@]}"; do
            if ! grep -Fxq "$unit" "$verify_global_user"; then
                printf '%s\n' "$unit"
            fi
        done
    fi


    # Per-user units

    if [[ -f "$saved_user" ]] \
        && get-enabled-user-units "$verify_user"
    then
        echo
        echo "Per-user units requested by bootstrap but still not enabled:"
        echo

        for unit in "${user_enable[@]}"; do
            if ! grep -Fxq "$unit" "$verify_user"; then
                printf '%s\n' "$unit"
            fi
        done
    fi


    # Default target

    if [[ -n "$saved_target" ]]; then

        verified_target="$(systemctl get-default 2>/dev/null || true)"

        echo
        printf 'Default target: %s\n' "$verified_target"

        if [[ "$verified_target" != "$saved_target" ]]; then
            warn "Default target does not match saved target: $saved_target"
        fi
    fi


    # -----------------------------------------------------------------------
    # Cleanup
    # -----------------------------------------------------------------------

    rm -f \
        "$tmp_system" \
        "$tmp_global_user" \
        "$tmp_user" \
        "$missing_system" \
        "$missing_global_user" \
        "$missing_user" \
        "$verify_system" \
        "$verify_global_user" \
        "$verify_user"


    echo
    echo "Services were enabled only; nothing was started or restarted."
}


flatpak-remote-url()
{
    local scope="$1"
    local remote="$2"

    if [[ "$scope" == "system" ]]; then
        flatpak remotes \
            --system \
            --columns=name,url \
            2>/dev/null
    else
        flatpak remotes \
            --user \
            --columns=name,url \
            2>/dev/null
    fi \
        | awk -F '\t' -v remote="$remote" '
            $1 == remote {
                print $2
                exit
            }
        '
}


restore-flatpak-remotes()
{
    local manifest="$PACKAGES/flatpak-remotes.txt"

    local scope
    local remote
    local url
    local existing_url

    [[ -f "$manifest" ]] || return 0

    command -v flatpak >/dev/null 2>&1 || {
        warn "Flatpak is not installed; skipping Flatpak remotes."
        return
    }

    info "Restoring Flatpak remotes"

    while IFS=$'\t' read -r scope remote url; do

        [[ -n "$scope" ]] || continue
        [[ -n "$remote" ]] || continue
        [[ -n "$url" ]] || continue

        existing_url="$(
            flatpak-remote-url "$scope" "$remote"
        )"

        if [[ -n "$existing_url" ]]; then

            if [[ "$existing_url" != "$url" ]]; then
                warn "Flatpak remote $remote already exists with a different URL:"
                warn "  current: $existing_url"
                warn "  saved:   $url"
            fi

            continue
        fi


        echo "Adding $scope Flatpak remote: $remote"

        if [[ "$scope" == "system" ]]; then

            sudo flatpak remote-add \
                --system \
                --if-not-exists \
                "$remote" \
                "$url"

        elif [[ "$scope" == "user" ]]; then

            flatpak remote-add \
                --user \
                --if-not-exists \
                "$remote" \
                "$url"

        else
            warn "Unknown Flatpak scope '$scope' for remote $remote"
        fi

    done < "$manifest"
}


flatpak-app-installed()
{
    local scope="$1"
    local app="$2"

    if [[ "$scope" == "system" ]]; then
        flatpak list \
            --system \
            --app \
            --columns=application \
            2>/dev/null
    else
        flatpak list \
            --user \
            --app \
            --columns=application \
            2>/dev/null
    fi \
        | grep -Fxq "$app"
}


install-flatpaks()
{
    local manifest="$PACKAGES/flatpak.txt"

    local scope
    local app
    local remote

    [[ -f "$manifest" ]] || return 0

    if ! command -v flatpak >/dev/null 2>&1; then
        warn "Flatpak is not installed; skipping Flatpak applications."
        return
    fi

    restore-flatpak-remotes

    info "Installing Flatpak applications"

    while IFS=$'\t' read -r scope app remote; do

        [[ -n "$scope" ]] || continue
        [[ -n "$app" ]] || continue
        [[ -n "$remote" ]] || continue

        if flatpak-app-installed "$scope" "$app"; then
            echo "$app already installed ($scope)"
            continue
        fi

        echo "Installing $app ($scope from $remote)"

        if [[ "$scope" == "system" ]]; then

            if ! sudo flatpak install \
                --system \
                -y \
                "$remote" \
                "$app"
            then
                warn "Could not install Flatpak: $app"
            fi

        elif [[ "$scope" == "user" ]]; then

            if ! flatpak install \
                --user \
                -y \
                "$remote" \
                "$app"
            then
                warn "Could not install Flatpak: $app"
            fi

        else
            warn "Unknown Flatpak scope '$scope' for $app"
        fi

    done < "$manifest"
}


install-foreign-packages()
{
    local -a packages=()
    local package

    [[ -f "$PACKAGES/foreign.txt" ]] || return 0

    bootstrap-yay || {
        warn "Skipping foreign/AUR packages."
        return
    }

    mapfile -t packages < <(
        grep -Ev \
            '^[[:space:]]*(#|$)|^yay$|^yay-bin$' \
            "$PACKAGES/foreign.txt"
    )

    if (( ${#packages[@]} == 0 )); then
        return
    fi

    info "Installing foreign / AUR packages"

    for package in "${packages[@]}"; do

        echo "$package"

        if ! yay -S --needed "$package"; then
            warn "Could not restore foreign package: $package"
        fi

    done
}


# ---------------------------------------------------------------------------
# Packages
# ---------------------------------------------------------------------------

install-official-packages()
{
    local -a packages=()

    [[ -f "$PACKAGES/official.txt" ]] \
        || die "Missing packages/official.txt"

    mapfile -t packages < <(
        grep -Ev '^[[:space:]]*(#|$)' \
            "$PACKAGES/official.txt"
    )

    if (( ${#packages[@]} == 0 )); then
        info "No official packages to install"
        return
    fi

    info "Installing official Arch packages"

    sudo pacman -Syu --needed "${packages[@]}"
}


bootstrap-yay()
{
    local helper_pkg="yay"
    local tmp

    # All Yay variants provide the executable named "yay".
    if command -v yay >/dev/null 2>&1; then
        return 0
    fi

    # If Yay really is missing, recreate the same variant that was
    # installed on the saved machine.
    if grep -qx 'yay-git' "$PACKAGES/foreign.txt" 2>/dev/null; then
        helper_pkg="yay-git"
    elif grep -qx 'yay-bin' "$PACKAGES/foreign.txt" 2>/dev/null; then
        helper_pkg="yay-bin"
    elif grep -qx 'yay' "$PACKAGES/foreign.txt" 2>/dev/null; then
        helper_pkg="yay"
    fi

    warn "yay is not currently installed."

    confirm "Bootstrap $helper_pkg from the AUR?" \
        || return 1

    sudo pacman -S --needed base-devel git

    tmp="$(mktemp -d)"

    git clone \
        "https://aur.archlinux.org/${helper_pkg}.git" \
        "$tmp/$helper_pkg"

    echo
    echo "Reviewing PKGBUILD before building:"
    echo

    "${PAGER:-less}" "$tmp/$helper_pkg/PKGBUILD"

    confirm "Build and install $helper_pkg?" || {
        rm -rf "$tmp"
        return 1
    }

    (
        cd "$tmp/$helper_pkg"
        makepkg -si
    )

    rm -rf "$tmp"
}


install-foreign-packages()
{
    local -a packages=()
    local package

    [[ -f "$PACKAGES/foreign.txt" ]] || return 0

    bootstrap-yay || {
        warn "Skipping foreign/AUR packages."
        return
    }

    mapfile -t packages < <(
        grep -Ev \
            '^[[:space:]]*(#|$)|^yay$|^yay-bin$|^yay-git$' \
            "$PACKAGES/foreign.txt"
    )

    if (( ${#packages[@]} == 0 )); then
        return
    fi

    info "Installing foreign / AUR packages"

    for package in "${packages[@]}"; do

        # makepkg/AUR builds can generate companion *-debug packages that
        # are installed locally but are not independent AUR package entries.
        # Reconstruct them through the package that produced them instead.
        if [[ "$package" == *-debug ]]; then
            echo "$package"
            echo "  generated debug package; skipping direct AUR lookup"
            continue
        fi

        echo "$package"

        if ! yay -S --needed "$package"; then
            warn "Could not restore foreign package: $package"
        fi

    done
}


install-code-extensions()
{
    [[ -f "$PACKAGES/code-extensions.txt" ]] || return

    if ! command -v code >/dev/null 2>&1; then
        warn "Code OSS not installed; skipping extensions."
        return
    fi

    info "Installing Code extensions"

    while IFS= read -r extension; do
        [[ -n "$extension" ]] || continue

        echo "$extension"

        code --install-extension "$extension" \
            >/dev/null 2>&1 \
            || warn "Could not install extension: $extension"

    done < "$PACKAGES/code-extensions.txt"
}


install-packages()
{
    install-official-packages
    install-foreign-packages
    install-flatpaks
    install-code-extensions
}


# ---------------------------------------------------------------------------
# GNU Stow dotfiles
# ---------------------------------------------------------------------------

backup-stow-conflicts()
{
    local package="$1"
    local package_root="$DOTFILES/$package"

    local item
    local rel
    local target
    local resolved

    while IFS= read -r -d '' item; do

        rel="${item#$package_root/}"
        target="$HOME/$rel"

        if [[ -e "$target" || -L "$target" ]]; then

            resolved="$(
                readlink -f -- "$target" 2>/dev/null \
                    || true
            )"

            # Whether the final component or one of its parents is symlinked,
            # don't touch it if it resolves back into this Stow package.
            case "$resolved" in
                "$package_root"|"$package_root"/*)
                    continue
                    ;;
            esac

            warn "Backing up conflicting file: $target"

            backup-user-path "$target"
            rm -rf -- "$target"
        fi

    done < <(
        find "$package_root" \
            \( -type f -o -type l \) \
            -print0
    )
}


restore-dotfiles()
{
    local package
    local name

    command -v stow >/dev/null 2>&1 \
        || die "GNU Stow is not installed."

    info "Restoring Stow-managed dotfiles"

    for package in "$DOTFILES"/*; do
        [[ -d "$package" ]] || continue

        name="$(basename "$package")"

        echo "$name"

        backup-stow-conflicts "$name"

        stow \
            --dir="$DOTFILES" \
            --target="$HOME" \
            --restow \
            "$name"
    done
}


# ---------------------------------------------------------------------------
# Vim plugins
# ---------------------------------------------------------------------------

restore-vim-plugins()
{
    local inventory="$STATE/vim-plugin-git.txt"

    local rel
    local remote
    local branch
    local commit
    local saved_dirty

    local target
    local name
    local patch

    [[ -f "$inventory" ]] || {
        warn "No Vim plugin inventory found."
        return
    }

    info "Restoring Vim plugins"

    while IFS=$'\t' read -r \
        rel remote branch commit saved_dirty
    do
        [[ -n "$rel" ]] || continue

        target="$HOME/$rel"
        name="$(basename "$target")"
        patch="$PATCHES/vim-${name}.patch"

        echo "$name"

        if [[ -d "$target/.git" ]]; then

            if [[ -n "$(git -C "$target" status --porcelain)" ]]; then
                warn "$name already contains local changes; leaving it alone."
                continue
            fi

            if ! git -C "$target" cat-file -e "${commit}^{commit}" 2>/dev/null; then
                echo "  fetching missing saved commit"
                git -C "$target" fetch --all --tags
            fi

        elif [[ -e "$target" ]]; then

            warn "$target exists but is not a Git repository; skipping."
            continue

        else
            mkdir -p "$(dirname "$target")"

            [[ "$remote" != "-" ]] \
                || die "No remote recorded for Vim plugin: $name"
            
            [[ "$commit" != "-" ]] \
                || die "No commit recorded for Vim plugin: $name"

            git clone "$remote" "$target"
        fi

        if [[ "$branch" == "DETACHED" ]]; then
            git -C "$target" checkout --detach "$commit"
        else
            # Keep the plugin on its saved branch while pinning it to
            # the exact commit recorded by env-save.
            git -C "$target" checkout -B "$branch" "$commit"
        
            # Restore upstream tracking when that branch exists on origin.
            if git -C "$target" show-ref \
                --verify \
                --quiet \
                "refs/remotes/origin/$branch"
            then
                git -C "$target" branch \
                    --set-upstream-to="origin/$branch" \
                    "$branch" \
                    >/dev/null
            fi
        fi

        if [[ "$saved_dirty" == "DIRTY" ]]; then
        
            [[ -f "$patch" ]] \
                || die "$name was DIRTY in the saved environment but no patch exists."
        
            echo "  applying $(basename "$patch")"
        
            git -C "$target" apply --check "$patch" \
                || die "Saved patch does not apply cleanly to $name."
        
            git -C "$target" apply "$patch"
        fi

    done < "$inventory"
}


# ---------------------------------------------------------------------------
# Saved user configuration
# ---------------------------------------------------------------------------

restore-user-tree()
{
    local src_root="$1"

    local src
    local rel
    local target

    [[ -d "$src_root" ]] || return

    while IFS= read -r -d '' src; do

        rel="${src#$src_root/}"
        target="$HOME/$rel"

        # Real directory, but NOT a symlink to a directory.
        if [[ -d "$src" && ! -L "$src" ]]; then

            # Don't follow an existing destination symlink.
            if [[ -L "$target" ]] \
                || [[ -e "$target" && ! -d "$target" ]]
            then
                warn "Backing up conflicting path: $target"

                backup-user-path "$target"
                rm -rf -- "$target"
            fi

            mkdir -p -- "$target"
            continue
        fi

        if [[ -e "$target" || -L "$target" ]]; then

            if same-entry "$src" "$target"; then
                continue
            fi

            warn "Backing up conflicting file: $target"

            backup-user-path "$target"
            rm -rf -- "$target"
        fi

        mkdir -p -- "$(dirname "$target")"

        cp -a -- "$src" "$target"

    done < <(
        find "$src_root" \
            -mindepth 1 \
            -print0 \
            | LC_ALL=C sort -z
    )
}


restore-user-config()
{
    info "Restoring saved user configuration"

    echo "Existing conflicting files will be backed up under:"
    echo
    echo "  $BACKUP_ROOT"
    echo

    confirm "Restore user configuration?" || return

    restore-user-tree "$USER_CONFIG"
    
    if [[ -d "$HOME/.ssh" ]]; then
        chmod 700 "$HOME/.ssh"
    fi
    
    if [[ -f "$HOME/.ssh/config" ]]; then
        chmod 600 "$HOME/.ssh/config"
    fi
}


# ---------------------------------------------------------------------------
# Safe system configuration restore
# ---------------------------------------------------------------------------

system-safe-candidates()
{
    local rel
    local src

    local -a safe_trees=(
        "etc/pacman.d/hooks"

        "etc/modprobe.d"
        "etc/modules-load.d"

        "etc/udev/rules.d"

        "etc/sysctl.d"
        "etc/tmpfiles.d"

        "etc/sddm.conf.d"
        "etc/X11/xorg.conf.d"
        "etc/environment.d"

        "etc/NetworkManager/conf.d"
        "etc/NetworkManager/dispatcher.d"

        "etc/systemd/logind.conf.d"
        "etc/systemd/sleep.conf.d"
        "etc/systemd/resolved.conf.d"
        "etc/systemd/timesyncd.conf.d"
        "etc/systemd/journald.conf.d"

        "etc/security/limits.d"
        "etc/ssh/sshd_config.d"

        "usr/local/bin"
    )

    # Ordinary configuration trees: regular files and deliberate symlinks.
    for rel in "${safe_trees[@]}"; do

        src="$SYSTEM_CONFIG/$rel"

        [[ -d "$src" ]] || continue

        find "$src" \
            \( -type f -o -type l \) \
            -print0

    done


    # systemd's /etc/systemd/system and /etc/systemd/user trees need
    # special handling. env-save also captures enablement/alias symlinks
    # here, and those should NOT be blindly transplanted.
    for rel in \
        "etc/systemd/system" \
        "etc/systemd/user"
    do

        src="$SYSTEM_CONFIG/$rel"

        [[ -d "$src" ]] || continue

        # Restore actual custom unit files and drop-ins only.
        # Service enablement is reconstructed separately from state/.
        find "$src" \
            -type f \
            -print0

    done
}


# ---------------------------------------------------------------------------
# systemd service restoration
# ---------------------------------------------------------------------------

system-unit-exists()
{
    local unit="$1"

    systemctl list-unit-files \
        --no-legend \
        --no-pager \
        "$unit" \
        2>/dev/null \
        | awk '{print $1}' \
        | grep -Fxq "$unit"
}


user-unit-exists()
{
    local unit="$1"

    systemctl --user list-unit-files \
        --no-legend \
        --no-pager \
        "$unit" \
        2>/dev/null \
        | awk '{print $1}' \
        | grep -Fxq "$unit"
}


get-enabled-system-units()
{
    local output="$1"

    systemctl list-unit-files \
        --state=enabled \
        --no-legend \
        --no-pager \
        | awk '{print $1}' \
        | LC_ALL=C sort -u \
        > "$output"
}


get-enabled-global-user-units()
{
    local output="$1"

    systemctl --global list-unit-files \
        --state=enabled \
        --no-legend \
        --no-pager \
        2>/dev/null \
        | awk '{print $1}' \
        | LC_ALL=C sort -u \
        > "$output"
}


get-enabled-user-units()
{
    local output="$1"
    local tmp_effective
    local tmp_global

    tmp_effective="$(mktemp)"
    tmp_global="$(mktemp)"

    if ! systemctl --user list-unit-files \
        --state=enabled \
        --no-legend \
        --no-pager \
        2>/dev/null \
        | awk '{print $1}' \
        | LC_ALL=C sort -u \
        > "$tmp_effective"
    then
        rm -f "$tmp_effective" "$tmp_global"
        return 1
    fi

    if ! get-enabled-global-user-units "$tmp_global"; then
        rm -f "$tmp_effective" "$tmp_global"
        return 1
    fi

    comm -23 \
        "$tmp_effective" \
        "$tmp_global" \
        > "$output"

    rm -f "$tmp_effective" "$tmp_global"
}


global-user-unit-exists()
{
    local unit="$1"

    systemctl --global list-unit-files \
        --no-legend \
        --no-pager \
        "$unit" \
        2>/dev/null \
        | awk '{print $1}' \
        | grep -Fxq "$unit"
}


# ---------------------------------------------------------------------------
# System configuration review
# ---------------------------------------------------------------------------

review-system-config()
{
    local src
    local rel
    local target
    local src_link
    local target_link
    local differences=0
    local efi_available=1

    [[ -d "$SYSTEM_CONFIG" ]] || {
        warn "No saved system configuration found."
        return
    }

    info "System configuration differences"

    sudo -v \
        || die "sudo access is required to review system configuration."

    if [[ -d "$SYSTEM_CONFIG/efi" ]] && ! mountpoint -q /efi; then
        warn "/efi is not mounted; EFI configuration comparisons will be skipped."
        efi_available=0
    fi

    while IFS= read -r -d '' src; do

        rel="${src#$SYSTEM_CONFIG/}"
        target="/$rel"

        if [[ "$rel" == efi/* ]] && (( ! efi_available )); then
            continue
        fi

        # Target paths may not be traversable by the normal user.
        if ! sudo test -e "$target" && ! sudo test -L "$target"; then
            printf 'MISSING   /%s\n' "$rel"
            differences=$((differences + 1))
            continue
        fi

        if [[ -L "$src" ]]; then

            if ! sudo test -L "$target"; then
                printf 'DIFFER   /%s\n' "$rel"
                differences=$((differences + 1))
                continue
            fi

            src_link="$(readlink -- "$src")"
            target_link="$(sudo readlink -- "$target")"

            if [[ "$src_link" != "$target_link" ]]; then
                printf 'DIFFER   /%s\n' "$rel"
                differences=$((differences + 1))
            fi

        elif [[ -f "$src" ]]; then

            # A saved regular file should remain a regular file, not a symlink
            # that merely happens to resolve to identical contents.
            if sudo test -L "$target" \
                || ! sudo test -f "$target" \
                || ! sudo cmp -s "$src" "$target"
            then
                printf 'DIFFER   /%s\n' "$rel"
                differences=$((differences + 1))
            fi
        fi

    done < <(
        find "$SYSTEM_CONFIG" \
            \( -type f -o -type l \) \
            -print0 \
            | LC_ALL=C sort -z
    )

    if (( differences == 0 )); then
        echo "All saved system configuration entries match this machine."
    else
        echo
        echo "$differences system configuration entries differ."
    fi
}


review-services()
{
    local tmp_system
    local tmp_user

    tmp_system="$(mktemp)"
    tmp_user="$(mktemp)"

    info "Systemd enablement differences"

    if [[ -f "$STATE/systemd-system-enabled.txt" ]]; then

        if systemctl list-unit-files \
            --state=enabled \
            --no-legend \
            --no-pager \
            | awk '{print $1}' \
            | LC_ALL=C sort \
            > "$tmp_system"
        then
            echo "Saved system units not currently enabled:"
            echo

            comm -23 \
                "$STATE/systemd-system-enabled.txt" \
                "$tmp_system"

            echo
            echo "Currently enabled system units not in saved state:"
            echo

            comm -13 \
                "$STATE/systemd-system-enabled.txt" \
                "$tmp_system"
        else
            warn "Could not query system systemd units."
        fi

    else
        warn "Saved systemd system-unit state is missing."
    fi


    echo

    if [[ -f "$STATE/systemd-user-enabled.txt" ]]; then

        # Per-user only, like the saved state: globally enabled user units
        # would otherwise show up as drift.
        if get-enabled-user-units "$tmp_user"; then
            echo "Saved user units not currently enabled:"
            echo

            comm -23 \
                "$STATE/systemd-user-enabled.txt" \
                "$tmp_user"

            echo
            echo "Currently enabled user units not in saved state:"
            echo

            comm -13 \
                "$STATE/systemd-user-enabled.txt" \
                "$tmp_user"
        else
            warn "Could not query the user systemd manager."
        fi

    else
        warn "Saved systemd user-unit state is missing."
    fi

    rm -f "$tmp_system" "$tmp_user"
}


review-environment()
{
    review-system-config
    review-services

    echo
    echo "No system configuration was modified."
}


# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------

usage()
{
    cat <<EOF
Usage:

  bootstrap packages
  bootstrap dotfiles
  bootstrap vim
  bootstrap user
  bootstrap system-safe
  bootstrap services
  bootstrap review
  bootstrap all

Commands:

  packages      Install official/AUR packages and Code extensions
  dotfiles      Restore GNU Stow-managed dotfiles
  vim           Restore pinned Vim plugin repositories and patches
  user          Restore saved user configuration
  system-safe   Restore curated portable system configuration
  services      Restore saved systemd unit enablement/default target
  review        Compare saved system/service state without modifying it
  all           Run packages, dotfiles, vim, user, then review
                (does NOT restore system configuration)

EOF
}


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

require-arch
require-not-root
require-repo

(( $# <= 1 )) || {
    usage
    exit 2
}

ACTION="${1:-help}"

case "$ACTION" in

    packages)
        install-packages
        ;;

    dotfiles)
        restore-dotfiles
        ;;

    vim)
        restore-vim-plugins
        ;;

    user)
        restore-user-config
        ;;


    system-safe)
        restore-system-safe
        ;;

    services)
        restore-services
        ;;

    review)
        review-environment
        ;;

    all)
        install-packages
        restore-dotfiles
        restore-vim-plugins
        restore-user-config
        review-environment
        ;;

    help|-h|--help)
        usage
        ;;

    *)
        usage
        exit 1
        ;;
esac


echo
echo "--- Bootstrap complete ---"
echo
