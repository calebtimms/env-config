#!/usr/bin/env bash

set -uo pipefail

REPO="${ENV_CONFIG_REPO:-$HOME/env-config}"

PACKAGES="$REPO/packages"
STATE="$REPO/state"
SYSTEM="$REPO/system"

mkdir -p \
    "$PACKAGES" \
    "$STATE" \
    "$SYSTEM/etc" \
    "$SYSTEM/efi"


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

run-if-exists()
{
    local command_name="$1"
    local output="$2"
    shift 2

    if command -v "$command_name" >/dev/null 2>&1; then
        "$@" > "$output" 2>&1 || true
    else
        rm -f "$output"
    fi
}


capture-root-file()
{
    local src="$1"
    local dest="$SYSTEM/${src#/}"

    if ! sudo test -f "$src"; then
        return
    fi

    mkdir -p "$(dirname "$dest")"

    # sudo reads the protected file, but the user's shell creates the
    # destination so the resulting Git file remains owned by the user.
    sudo cat "$src" > "$dest"
}


capture-root-tree()
{
    local src="$1"
    local dest="$SYSTEM/${src#/}"
    local parent
    local base
    local tmp

    if ! sudo test -d "$src"; then
        rm -rf "$dest"
        return
    fi

    parent="$(dirname "$src")"
    base="$(basename "$src")"

    tmp="$(mktemp -d)" || {
        echo "WARNING: Failed to create temporary directory for $src" >&2
        return 1
    }

    # Use explicit GNU tar paths/options and ignore any inherited TAR_OPTIONS.
    # Extract as the current user so files in the Git repo remain user-owned.
    if sudo env -u TAR_OPTIONS /usr/bin/tar \
            --create \
            --file=- \
            --directory="$parent" \
            -- "$base" \
        | env -u TAR_OPTIONS /usr/bin/tar \
            --extract \
            --file=- \
            --directory="$tmp" \
            --no-same-owner
    then
        mkdir -p "$(dirname "$dest")"

        # Only destroy the previous capture AFTER the new one succeeded.
        rm -rf "$dest"
        mv "$tmp/$base" "$dest"
    else
        echo "WARNING: Failed to capture $src" >&2
    fi

    rm -rf "$tmp"
}


capture-user-tree()
{
    local src="$1"
    local rel="${src#$HOME/}"
    local dest="$REPO/user/$rel"

    if [[ ! -d "$src" ]]; then
        rm -rf "$dest"
        return
    fi

    rm -rf "$dest"
    mkdir -p "$(dirname "$dest")"

    cp -a "$src" "$dest"
}


capture-user-file()
{
    local src="$1"
    local rel="${src#$HOME/}"
    local dest="$REPO/user/$rel"

    if [[ ! -f "$src" ]]; then
        rm -f "$dest"
        return
    fi

    mkdir -p "$(dirname "$dest")"
    cp -a "$src" "$dest"
}


# capture-user-file, minus lines matching an extended regex: bookkeeping keys
# an application rewrites on its own, which never reflect a settings change.
capture-user-file-without()
{
    local src="$1"
    local pattern="$2"
    local rel="${src#$HOME/}"
    local dest="$REPO/user/$rel"

    if [[ ! -f "$src" ]]; then
        rm -f "$dest"
        return
    fi

    mkdir -p "$(dirname "$dest")"
    grep -vE "$pattern" "$src" > "$dest" || true
}


capture-user-state-file()
{
    local src="$1"
    local rel="${src#$HOME/}"
    local dest="$STATE/user/$rel"

    if [[ ! -f "$src" ]]; then
        rm -f "$dest"
        return
    fi

    mkdir -p "$(dirname "$dest")"
    cp -a "$src" "$dest"
}


capture-user-state-tree()
{
    local src="$1"
    local rel="${src#$HOME/}"
    local dest="$STATE/user/$rel"

    if [[ ! -d "$src" ]]; then
        rm -rf "$dest"
        return
    fi

    rm -rf "$dest"
    mkdir -p "$(dirname "$dest")"
    cp -a "$src" "$dest"
}


capture-git-repo-inventory()
{
    local output="$1"
    shift

    : > "$output"

    local root
    local git_dir
    local repo
    local rel
    local remote
    local branch
    local commit
    local dirty

    for root in "$@"; do
        [[ -d "$root" ]] || continue

        while IFS= read -r -d '' git_dir; do
            repo="${git_dir%/.git}"
            rel="${repo#$HOME/}"

            remote="$(
                git -C "$repo" remote get-url origin 2>/dev/null \
                    || printf '%s' '-'
            )"

            branch="$(
                git -C "$repo" branch --show-current 2>/dev/null
            )"

            [[ -n "$branch" ]] || branch="DETACHED"

            commit="$(
                git -C "$repo" rev-parse HEAD 2>/dev/null \
                    || printf '%s' '-'
            )"

            if [[ -n "$(git -C "$repo" status --porcelain 2>/dev/null)" ]]; then
                dirty="DIRTY"
            else
                dirty="clean"
            fi

            printf '%s\t%s\t%s\t%s\t%s\n' \
                "$rel" \
                "$remote" \
                "$branch" \
                "$commit" \
                "$dirty" \
                >> "$output"

        done < <(
            find "$root" \
                -type d \
                -name .git \
                -prune \
                -print0 2>/dev/null
        )
    done
    LC_ALL=C sort -o "$output" "$output"
}


# Rewrite kernel disk/partition names (/dev/nvme0n1p2, /dev/sda1), which
# depend on probe order and can swap between boots, to their stable
# /dev/disk/by-id paths. Other paths, such as /dev/mapper/*, pass through.
stable-device-names()
{
    awk '
        NR == FNR {
            split($0, f, "[ ]")
            if (f[2] != "" && (f[3] == "disk" || f[3] == "part"))
                byid[f[1]] = "/dev/disk/by-id/" f[2]
            next
        }
        {
            line = $0
            out = ""
            while (match(line, /\/dev\/[A-Za-z0-9_.-]+/)) {
                dev = substr(line, RSTART, RLENGTH)
                out = out substr(line, 1, RSTART - 1) ((dev in byid) ? byid[dev] : dev)
                line = substr(line, RSTART + RLENGTH)
            }
            print out line
        }' <(lsblk --raw --noheadings --paths --output NAME,ID-LINK,TYPE) -
}


# Drop the firmware's own BBS(...) boot entries (UEFI:CD/DVD Drive,
# UEFI:Removable Device, UEFI:Network Device), which it adds and removes on
# its own, from both the efibootmgr entry list and BootOrder.
drop-firmware-boot-entries()
{
    awk '
        { line[NR] = $0 }
        /\tBBS\(/ { bbs[substr($0, 5, 4)] = 1 }
        END {
            for (i = 1; i <= NR; i++) {
                $0 = line[i]
                if (/^Boot[0-9A-F]{4}/) skip = (substr($0, 5, 4) in bbs)
                else if (!/^[[:space:]]/) skip = 0
                if (skip) continue
                if (/^BootOrder: /) {
                    n = split(substr($0, 12), ids, ",")
                    $0 = "BootOrder:"; sep = " "
                    for (j = 1; j <= n; j++)
                        if (!(ids[j] in bbs)) { $0 = $0 sep ids[j]; sep = "," }
                }
                print
            }
        }'
}


# ---------------------------------------------------------------------------
# Pacman / package state
# ---------------------------------------------------------------------------

pacman -Qqen | LC_ALL=C sort > "$PACKAGES/official.txt"
pacman -Qqem | LC_ALL=C sort > "$PACKAGES/foreign.txt"

# Exact version of every installed package, for reference and rollback.
# Bootstrap installs from official.txt/foreign.txt only.
pacman -Q | LC_ALL=C sort > "$PACKAGES/all-versioned.txt"

# ---------------------------------------------------------------------------
# Flatpak
# ---------------------------------------------------------------------------

if command -v flatpak >/dev/null 2>&1; then

    # Installed applications:
    #
    #   scope<TAB>application<TAB>origin
    #
    # Keep user/system scope because Flatpak treats these as distinct
    # installations.

    {
        flatpak list \
            --system \
            --app \
            --columns=application,origin \
            2>/dev/null \
            | awk -F '\t' '
                NF >= 2 {
                    printf "system\t%s\t%s\n", $1, $2
                }
            ' \
            || true

        flatpak list \
            --user \
            --app \
            --columns=application,origin \
            2>/dev/null \
            | awk -F '\t' '
                NF >= 2 {
                    printf "user\t%s\t%s\n", $1, $2
                }
            ' \
            || true

    } | LC_ALL=C sort -u \
        > "$PACKAGES/flatpak.txt"


    # Configured repositories:
    #
    #   scope<TAB>name<TAB>url

    {
        flatpak remotes \
            --system \
            --columns=name,url \
            2>/dev/null \
            | awk -F '\t' '
                NF >= 2 {
                    printf "system\t%s\t%s\n", $1, $2
                }
            ' \
            || true

        flatpak remotes \
            --user \
            --columns=name,url \
            2>/dev/null \
            | awk -F '\t' '
                NF >= 2 {
                    printf "user\t%s\t%s\n", $1, $2
                }
            ' \
            || true

    } | LC_ALL=C sort -u \
        > "$PACKAGES/flatpak-remotes.txt"

else
    rm -f \
        "$PACKAGES/flatpak.txt" \
        "$PACKAGES/flatpak-remotes.txt"
fi


# VS Code / Code extensions
if command -v code >/dev/null 2>&1; then
    code --list-extensions | LC_ALL=C sort > "$PACKAGES/code-extensions.txt"
fi


# ---------------------------------------------------------------------------
# systemd state
# ---------------------------------------------------------------------------

systemctl list-unit-files \
    --state=enabled \
    --no-legend \
    --no-pager \
    | awk '{print $1}' \
    | LC_ALL=C sort \
    > "$STATE/systemd-system-enabled.txt"


# ---------------------------------------------------------------------------
# User systemd enablement
#
# systemctl --user reports the effective user-unit view, which includes
# units enabled globally for all users. Save global enablement separately,
# then record only the additional per-user enablement in user-enabled.txt.
# ---------------------------------------------------------------------------

if systemctl --global list-unit-files \
    --state=enabled \
    --no-legend \
    --no-pager \
    2>/dev/null \
    | awk '{print $1}' \
    | LC_ALL=C sort -u \
    > "$STATE/systemd-global-user-enabled.txt"
then
    :
else
    rm -f "$STATE/systemd-global-user-enabled.txt"
fi


if [[ -f "$STATE/systemd-global-user-enabled.txt" ]]; then

    comm -23 \
        <(
            systemctl --user list-unit-files \
                --state=enabled \
                --no-legend \
                --no-pager \
                2>/dev/null \
                | awk '{print $1}' \
                | LC_ALL=C sort -u
        ) \
        "$STATE/systemd-global-user-enabled.txt" \
        > "$STATE/systemd-user-enabled.txt" \
        || true

else
    rm -f "$STATE/systemd-user-enabled.txt"
fi


systemctl get-default > "$STATE/systemd-default-target.txt" 2>&1 || true


# ---------------------------------------------------------------------------
# Basic system information
# ---------------------------------------------------------------------------

cat /proc/cmdline > "$STATE/kernel-cmdline.txt"

# The running kernel lags the installed linux package (already in
# all-versioned.txt) until a reboot, so it is left out with the per-boot IDs.
hostnamectl | grep -vE '^[[:space:]]*(Machine ID|Boot ID|Firmware Age|Kernel):' > "$STATE/hostnamectl.txt" 2>&1 || true

localectl status > "$STATE/localectl.txt" 2>&1 || true

timedatectl show \
    -p Timezone \
    -p LocalRTC \
    -p NTP \
    > "$STATE/timedatectl.txt" 2>&1 || true

# ---------------------------------------------------------------------------
# Hardware / filesystem layout
# ---------------------------------------------------------------------------

lsblk \
    --raw \
    --noheadings \
    --paths \
    --output NAME,SIZE,TYPE,FSTYPE,FSVER,LABEL,UUID,PARTUUID \
    | stable-device-names \
    | LC_ALL=C sort \
    > "$STATE/lsblk.txt"

# Mounted real filesystems, identified by UUID because kernel device names
# (nvme0n1 / nvme1n1) can swap between boots. Transient mounts are skipped.
findmnt \
    --real \
    --list \
    --noheadings \
    --output TARGET,FSTYPE,UUID,FSROOT,OPTIONS \
    | grep -vE '^/(run|mnt|media)(/|[[:space:]])' \
    | LC_ALL=C sort \
    > "$STATE/findmnt.txt"

# Basic PCI hardware inventory; does not require kernel module metadata.
lspci -nn > "$STATE/lspci.txt" 2>&1 || true

# Bound drivers ("Kernel driver in use") come from sysfs. The candidate
# "Kernel modules" lines need module metadata for the running kernel, which
# a kernel upgrade removes until the next reboot, so they are left out.
lspci -nnk 2>/dev/null \
    | grep -v $'^\tKernel modules:' \
    > "$STATE/lspci-kernel-drivers.txt" \
    || true


# ---------------------------------------------------------------------------
# Boot environment
# ---------------------------------------------------------------------------

if command -v sbctl >/dev/null 2>&1; then
    # Only the meaningful Secure Boot state; the rest of the output varies.
    sbctl status 2>/dev/null \
        | grep -E '^(Installed|Setup Mode|Secure Boot):' \
        > "$STATE/sbctl-status.txt" \
        || true
else
    rm -f "$STATE/sbctl-status.txt"
fi

SBCTL_UNICODE=0 sbctl --json verify 2>/dev/null \
    | jq -S . \
    > "$STATE/sbctl-verify.json" \
    || true

# ---------------------------------------------------------------------------
# Root-access state
# ---------------------------------------------------------------------------

HAVE_SUDO=0

if [[ "${1:-}" != "--no-root" ]]; then
    if sudo -v; then
        HAVE_SUDO=1
    fi
fi


if (( HAVE_SUDO )); then

    sudo blkid 2>/dev/null \
        | stable-device-names \
        | LC_ALL=C sort \
        > "$STATE/blkid.txt" \
        || true

    # Root can read the ESP, so no permission errors get spliced into the
    # output. "Current Stub" is the booted UKI's systemd-stub: a running-system
    # version that lags the systemd package until a reboot.
    sudo bootctl status 2>/dev/null \
        | grep -v 'Product: systemd-stub' \
        > "$STATE/bootctl.txt" \
        || true

    sudo efibootmgr -v 2>/dev/null \
        | grep -vE '^(BootCurrent|BootNext):' \
        | drop-firmware-boot-entries \
        > "$STATE/efibootmgr.txt" \
        || true

    sudo btrfs subvolume list / \
        | sed -n 's/.* path //p' \
        | grep -vE '(^|/)\.snapshots(/|$)' \
        | LC_ALL=C sort \
        > "$STATE/btrfs-subvolumes.txt"

    # Layout only: the "used" figures change constantly.
    sudo btrfs filesystem show \
        | sed -E \
            -e 's/[[:space:]]+FS bytes used .*$//' \
            -e 's/ used [^ ]+ path / path /' \
        > "$STATE/btrfs-filesystems.txt"

    if command -v pvs >/dev/null 2>&1; then
        # The PV name goes last so its longer by-id path doesn't misalign
        # the other columns.
        sudo pvs -o vg_name,pv_fmt,pv_attr,pv_size,pv_free,pv_name 2>&1 \
            | stable-device-names \
            > "$STATE/lvm-pvs.txt" \
            || true

        sudo vgs > "$STATE/lvm-vgs.txt" 2>&1 || true

        sudo lvs -a -o +devices 2>&1 \
            | stable-device-names \
            > "$STATE/lvm-lvs.txt" \
            || true
    fi


    # -----------------------------------------------------------------------
    # Carefully selected system configuration
    # -----------------------------------------------------------------------

    capture-root-file /etc/fstab
    capture-root-file /etc/crypttab
    
    capture-root-file /etc/mkinitcpio.conf
    
    capture-root-file /etc/pacman.conf
    capture-root-file /etc/makepkg.conf
    
    capture-root-file /etc/hostname
    capture-root-file /etc/hosts
    
    capture-root-file /etc/locale.conf
    capture-root-file /etc/locale.gen
    capture-root-file /etc/vconsole.conf
    
    capture-root-file /etc/environment
    
    capture-root-file /etc/snapper/configs/root
    
    capture-root-file /efi/loader/loader.conf

    capture-root-file /etc/systemd/logind.conf
    capture-root-file /etc/systemd/sleep.conf
    capture-root-file /etc/systemd/resolved.conf
    capture-root-file /etc/systemd/timesyncd.conf
    capture-root-file /etc/systemd/journald.conf
    
    capture-root-file /etc/ssh/sshd_config

    # -----------------------------------------------------------------------
    # Local system configuration trees
    # -----------------------------------------------------------------------
    
    capture-root-tree /etc/pacman.d/hooks
    
    capture-root-tree /etc/modprobe.d
    capture-root-tree /etc/modules-load.d
    
    capture-root-tree /etc/udev/rules.d
    
    capture-root-tree /etc/sysctl.d
    capture-root-tree /etc/tmpfiles.d
    
    capture-root-tree /etc/systemd/system
    capture-root-tree /etc/systemd/user
    
    capture-root-tree /etc/mkinitcpio.d
    capture-root-tree /etc/kernel
    
    capture-root-tree /etc/sddm.conf.d
    
    capture-root-tree /etc/X11/xorg.conf.d
    
    capture-root-tree /etc/environment.d
    
    capture-root-tree /etc/NetworkManager/conf.d
    capture-root-tree /etc/NetworkManager/dispatcher.d

    capture-root-tree /etc/systemd/logind.conf.d
    capture-root-tree /etc/systemd/sleep.conf.d
    capture-root-tree /etc/systemd/resolved.conf.d
    capture-root-tree /etc/systemd/timesyncd.conf.d
    capture-root-tree /etc/systemd/journald.conf.d
    
    capture-root-tree /etc/security/limits.d
    capture-root-tree /etc/ssh/sshd_config.d

    capture-root-tree /usr/local/bin

    LOADER_ENTRIES_DEST="$SYSTEM/efi/loader/entries"
    
    rm -rf "$LOADER_ENTRIES_DEST"
    
    if sudo test -d /efi/loader/entries; then
        mkdir -p "$LOADER_ENTRIES_DEST"
    
        while IFS= read -r entry; do
            dest="$SYSTEM/${entry#/}"
            sudo cat "$entry" > "$dest"
        done < <(
            sudo find /efi/loader/entries \
                -maxdepth 1 \
                -type f \
                -name '*.conf' \
                -print \
                | LC_ALL=C sort
        )
    fi
fi


# -----------------------------------------------------------------------
# User configuration trees/files
# -----------------------------------------------------------------------
capture-user-tree "$HOME/.config/systemd/user"
capture-user-tree "$HOME/.config/environment.d"
capture-user-tree "$HOME/.config/autostart"

capture-user-file "$HOME/.local/share/applications/sierra.desktop"
capture-user-file "$HOME/.local/share/icons/sierra.png"
capture-user-file "$HOME/.local/share/applications/trading-dashboard.desktop"

capture-user-file "$HOME/.ssh/config"

capture-user-file "$HOME/.config/mimeapps.list"

capture-user-file "$HOME/.config/user-dirs.dirs"
capture-user-file "$HOME/.config/user-dirs.locale"

# ---------------------------------------------------------------------------
# KDE / Plasma user configuration
# ---------------------------------------------------------------------------

capture-user-file "$HOME/.config/kdeglobals"

# _k_friendly_name is a display label KDE rewrites with whichever program last
# saved the file (e.g. "KWin" vs "System Settings").
capture-user-file-without "$HOME/.config/kglobalshortcutsrc" '^_k_friendly_name='

capture-user-file "$HOME/.config/kcminputrc"
capture-user-file "$HOME/.config/kscreenlockerrc"

capture-user-file "$HOME/.config/kwinrc"
capture-user-file "$HOME/.config/kwinrulesrc"

capture-user-file "$HOME/.config/plasma-localerc"

capture-user-file "$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc"

capture-user-file "$HOME/.config/plasmanotifyrc"
capture-user-file "$HOME/.config/plasmarc"
capture-user-file "$HOME/.config/plasmashellrc"

capture-user-file "$HOME/.config/powerdevilrc"
capture-user-file "$HOME/.config/powermanagementprofilesrc"

capture-user-file "$HOME/.config/plasmaparc"
capture-user-file "$HOME/.config/kded5rc" 

KWIN_OUTPUT_SRC="$HOME/.config/kwinoutputconfig.json"
KWIN_OUTPUT_DEST="$STATE/user/.config/kwinoutputconfig.json"

if [[ -f "$KWIN_OUTPUT_SRC" ]]; then
    mkdir -p "$(dirname "$KWIN_OUTPUT_DEST")"

    if command -v jq >/dev/null 2>&1; then
        jq --sort-keys . \
            "$KWIN_OUTPUT_SRC" \
            > "$KWIN_OUTPUT_DEST"
    else
        cp "$KWIN_OUTPUT_SRC" "$KWIN_OUTPUT_DEST"
    fi
else
    rm -f "$KWIN_OUTPUT_DEST"
fi

KWIN_POS_SRC="$HOME/.config/kde.org/kwin.conf"
KWIN_POS_DEST="$STATE/user/.config/kde.org/kwin-overrides.conf"

if [[ -f "$KWIN_POS_SRC" ]]; then
    mkdir -p "$(dirname "$KWIN_POS_DEST")"

    grep -E \
        '^(rememberwindowpositions_configOverrides|rememberwindowpositions_currentDefaultOverrideCount)=' \
        "$KWIN_POS_SRC" \
        > "$KWIN_POS_DEST" \
        || true
else
    rm -f "$KWIN_POS_DEST"
fi

rm -f "$STATE/user/.config/kde.org/kwin.conf"

capture-user-state-tree "$HOME/.config/kdedefaults"

capture-user-file "$HOME/.config/spectaclerc"

# ---------------------------------------------------------------------------
# Locally installed KDE / KWin extensions
# ---------------------------------------------------------------------------

capture-user-tree "$HOME/.local/share/kwin/scripts"
capture-user-tree "$HOME/.local/share/kwin/effects"
capture-user-tree "$HOME/.local/share/plasma/plasmoids"

# ---------------------------------------------------------------------------
# Code OSS
# ---------------------------------------------------------------------------

capture-user-file "$HOME/.config/Code - OSS/User/settings.json"
capture-user-file "$HOME/.config/Code - OSS/User/keybindings.json"

capture-user-tree "$HOME/.config/Code - OSS/User/snippets"

# ---------------------------------------------------------------------------
# VIM Plugins
# ---------------------------------------------------------------------------

capture-git-repo-inventory \
    "$STATE/vim-plugin-git.txt" \
    "$HOME/.vim/pack"

# ---------------------------------------------------------------------------
# GTK Config
# ---------------------------------------------------------------------------

capture-user-file "$HOME/.config/gtk-3.0/settings.ini"
capture-user-file "$HOME/.config/gtk-3.0/gtk.css"

capture-user-file "$HOME/.config/gtk-4.0/settings.ini"
capture-user-file "$HOME/.config/gtk-4.0/gtk.css"

# GTK/XSettings integration
capture-user-tree "$HOME/.config/xsettingsd"

# ---------------------------------------------------------------------------
# Optional user-space development tools
# ---------------------------------------------------------------------------

if command -v cargo >/dev/null 2>&1; then
    cargo install --list \
        > "$STATE/cargo-installed.txt" 2>&1 || true
else
    rm -f "$STATE/cargo-installed.txt"
fi

if command -v rustup >/dev/null 2>&1; then
    rustup toolchain list \
        | sed -E 's/[[:space:]]+\([^)]*\)$//' \
        | LC_ALL=C sort \
        > "$STATE/rust-toolchains.txt"
else
    rm -f "$STATE/rust-toolchains.txt"
fi

if command -v uv >/dev/null 2>&1; then
    uv tool list > "$STATE/uv-tools.txt" 2>&1 || true
fi

if command -v pipx >/dev/null 2>&1; then
    pipx list --short > "$STATE/pipx.txt" 2>&1 || true
fi

if command -v npm >/dev/null 2>&1; then
    # Only modules npm itself installed; pacman-owned ones (npm, node-gyp,
    # semver, ...) are already in all-versioned.txt.
    npm --global ls --depth=0 --parseable --long 2>/dev/null \
        | tail -n +2 \
        | while IFS=: read -r path module _; do
            pacman -Qqo "$path" >/dev/null 2>&1 || printf '%s\n' "$module"
        done \
        > "$STATE/npm-global.txt"
fi


# ---------------------------------------------------------------------------
# Finish
# ---------------------------------------------------------------------------

echo
echo "--- Environment saved ---"
echo

git -C "$REPO" status --short
